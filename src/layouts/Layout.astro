---
import '../styles/global.css';
import Topbar from '../components/Topbar.astro';

interface Props {
  title?: string;
}

const { title = 'Rahul Aithal' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Sans:ital,wght@0,300;0,400;1,300&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="crt-scanlines pointer-events-none fixed inset-0 z-[9999]"></div>
    <div class="crt-grain animate-grain pointer-events-none fixed -inset-[200%] opacity-40"></div>

    <Topbar />

    <div class="mx-auto max-w-[900px] px-10 pb-20 max-[600px]:px-5 max-[600px]:pb-15">
      <slot />
    </div>
  </body>
</html>
