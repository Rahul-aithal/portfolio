---
import AgentBrief from './AgentBrief.astro';
import { profile } from '../data/profile';

const links = profile.links;
---

<section class="border-b-2 border-line-strong py-16 max-[600px]:py-10" aria-labelledby="hero-heading">
  <div class="mb-5 font-mono text-[11px] tracking-[0.25em] text-blue-deep uppercase" data-reveal>
    Dwg. no. RA-01 <span class="text-faint" aria-hidden="true">——</span> Identification
  </div>

  <h1
    id="hero-heading"
    class="font-display leading-[0.95] font-bold tracking-tight text-ink"
    style="font-size: clamp(48px, 9vw, 96px);"
    data-reveal
  >
    Rahul<br />
    <span class="draw-in text-blue">Aithal</span><span
      class="ml-2 inline-block h-[0.7em] w-[10px] animate-blink-fast bg-stamp align-baseline"
      aria-hidden="true"
    ></span>
  </h1>

  <div
    class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[12px] tracking-[0.12em] uppercase"
    data-reveal
    style="transition-delay: 120ms;"
  >
    <span class="bg-blue px-2 py-0.5 font-semibold text-white dark:text-paper">Full-stack developer</span>
    <span aria-hidden="true" class="text-faint">/</span>
    <span class="text-ink-2">Systems builder</span>
    <span aria-hidden="true" class="text-faint">/</span>
    <span class="text-ink-2">Bengaluru, IN</span>
  </div>

  <div
    class="mt-8 max-w-[640px] border-2 border-line-strong bg-surface p-6 max-[600px]:p-5"
    data-reveal
    style="transition-delay: 200ms;"
  >
    <div class="mb-3 font-mono text-[10px] tracking-[0.25em] text-muted uppercase">
      Spec — summary
    </div>
    <p class="text-[16px] leading-[1.75] font-light text-ink-1">
      {profile.summary}
    </p>
  </div>

  <nav
    class="mt-7 flex flex-wrap gap-x-7 gap-y-3"
    aria-label="Profiles and contact"
    data-reveal
    style="transition-delay: 280ms;"
  >
    {
      links.map((link, i) => (
        <a
          href={link.href}
          target={link.href.startsWith('mailto:') ? undefined : '_blank'}
          rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
          class="u-sweep group font-mono text-[12px] tracking-[0.12em] text-ink-2 uppercase transition-colors duration-150 hover:text-blue-deep"
        >
          <span class="mr-1.5 text-faint group-hover:text-blue" aria-hidden="true">
            [{String(i + 1).padStart(2, '0')}]
          </span>
          {link.label}
        </a>
      ))
    }
  </nav>

  <AgentBrief />
</section>
