---
interface Props {
  num: string;
  title: string;
  id?: string;
}

const { num, title, id = `section-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` } =
  Astro.props;
---

<h2 id={id} class="mb-8 flex items-center gap-4" data-reveal>
  <span
    class="border-2 border-line-strong bg-surface px-2 py-1 font-mono text-[11px] font-semibold tracking-[0.1em] text-blue-deep"
  >
    {num}
  </span>
  <span class="font-display text-[26px] font-semibold tracking-tight text-ink">
    {title}
  </span>
  <span class="h-0.5 flex-1 bg-line-strong" aria-hidden="true"></span>
</h2>
