---
import SectionHeader from './SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
---

<section class="border-b-2 border-line-strong py-12" aria-labelledby="section-things-i-ve-built">
  <SectionHeader num="03" title="Things I've Built" id="section-things-i-ve-built" />

  {projects.map((project, i) => <ProjectCard {...project} delay={0.05 + i * 0.05} />)}
</section>
