---
import { agentBrief, agentSections } from '../data/agentBrief';
import { agentMarkdownUrl, llmsFullTxtUrl, llmsTxtUrl } from '../data/site';
---

<section
  class="mt-10 border-2 border-dashed border-blue-deep bg-blue-wash/60 p-6 max-[600px]:p-5"
  aria-labelledby="agent-brief-heading"
  data-reveal
>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
    <h2 id="agent-brief-heading" class="font-mono text-[11px] font-semibold tracking-[0.25em] text-blue-deep uppercase">
      Appendix A — Machine-readable context
    </h2>
    <button
      type="button"
      data-agent-copy
      class="btn-press flex min-h-9 cursor-pointer items-center gap-2 border-2 border-line-strong bg-surface px-3 text-[11px] tracking-[0.14em] uppercase text-ink-2 hover:border-blue hover:text-blue-deep"
      aria-label="Copy complete profile as Markdown for AI agents"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span data-agent-copy-label aria-live="polite">Copy</span>
    </button>
  </div>
  <div class="mt-2 max-w-[560px]">
    <p class="text-[13.5px] leading-[1.7] font-light text-ink-1">
      Use the <span class="font-mono text-[12px] font-medium text-blue-deep">Copy</span> button above to copy the complete profile as Markdown, or fetch a raw endpoint below. This page also
      publishes semantic HTML, Schema.org metadata,
      <code class="font-mono text-[12px] text-blue-deep">llms.txt</code>, and a full-text variant
      for language models.
    </p>
  </div>

  <details class="group mt-5 border border-line-strong bg-surface">
    <summary
      class="cursor-pointer px-4 py-3 font-mono text-[11px] tracking-[0.16em] text-ink-2 uppercase transition-colors hover:text-blue-deep"
    >
      Preview agent context
    </summary>
    <pre
      id="agent-brief"
      class="max-h-80 overflow-auto border-t border-line px-4 py-4 font-mono text-[12px] leading-[1.75] whitespace-pre-wrap text-ink-1"
    >{agentBrief}</pre>
  </details>

  <nav class="mt-4 flex flex-wrap gap-5" aria-label="AI-friendly formats">
    <a
      href={agentMarkdownUrl}
      class="u-sweep font-mono text-[11px] tracking-[0.14em] text-blue-deep uppercase"
      >/agent.md ↗</a
    >
    <a
      href={llmsTxtUrl}
      class="u-sweep font-mono text-[11px] tracking-[0.14em] text-blue-deep uppercase"
      >/llms.txt ↗</a
    >
    <a
      href={llmsFullTxtUrl}
      class="u-sweep font-mono text-[11px] tracking-[0.14em] text-blue-deep uppercase"
      >/llms-full.txt ↗</a
    >
  </nav>

  <nav class="mt-3 flex flex-wrap gap-x-4 gap-y-2" aria-label="Per-section documents">
    <span class="font-mono text-[10px] tracking-[0.2em] text-muted uppercase">
      Sections:
    </span>
    {
      agentSections.map((section) => (
        <a
          href={`/agent/${section.slug}.md`}
          class="u-sweep font-mono text-[11px] tracking-[0.14em] text-ink-2 uppercase transition-colors hover:text-blue-deep"
        >
          {section.title}
        </a>
      ))
    }
  </nav>
</section>

<script>
  function fallbackCopy(text: string) {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.left = '-9999px';
    document.body.append(textarea);
    textarea.select();

    const copied = document.execCommand('copy');
    textarea.remove();

    if (!copied) throw new Error('Copy command failed');
  }

  const copyButton = document.querySelector<HTMLButtonElement>('[data-agent-copy]');
  const copyLabel = copyButton?.querySelector<HTMLElement>('[data-agent-copy-label]');
  const defaultLabel = 'Copy';

  copyButton?.addEventListener('click', async () => {
    const brief = document.getElementById('agent-brief');
    if (!brief || !copyLabel) return;
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(brief.textContent ?? '');
      } else {
        fallbackCopy(brief.textContent ?? '');
      }
      copyLabel.textContent = 'Copied ✓';
    } catch {
      copyLabel.textContent = 'Failed';
    }
    window.setTimeout(() => {
      copyLabel.textContent = defaultLabel;
    }, 2200);
  });
</script>
