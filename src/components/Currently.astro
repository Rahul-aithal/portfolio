---
import SectionHeader from './SectionHeader.astro';
import { currently } from '../data/profile';
---

<section class="border-b-2 border-line-strong py-12" aria-labelledby="section-currently">
  <SectionHeader num="01" title="Currently" id="section-currently" />

  <ul class="border-2 border-line-strong bg-surface" data-reveal>
    {
      currently.map((text, i) => (
        <li
          class:list={[
            'flex items-baseline gap-4 px-6 py-4',
            i > 0 && 'border-t border-line',
          ]}
        >
          <span class="font-mono text-[11px] font-semibold text-blue-deep tabular-nums" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span
            class="text-[15px] leading-[1.7] font-light text-ink-1 [&_strong]:font-medium [&_strong]:text-ink"
            set:html={text}
          />
        </li>
      ))
    }
  </ul>
</section>
