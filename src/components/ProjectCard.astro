---
import type { Project } from '../data/projects';

interface Props extends Project {
  delay?: number;
}

const { num, name, featured = false, story, tags, links = [], delay = 0 } = Astro.props;
const headingId = `project-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<article
  class:list={[
    'group relative mb-6 border-2 p-7 transition-all duration-150 max-[600px]:p-5',
    featured
      ? 'border-blue-deep bg-blue-wash hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_var(--color-blue-deep)]'
      : 'border-line-strong bg-surface hover:-translate-y-0.5 hover:border-blue-deep hover:shadow-[6px_6px_0_0_var(--color-line-strong)]',
  ]}
  aria-labelledby={headingId}
  data-reveal
  style={`transition-delay: ${Math.round(delay * 1000)}ms`}
>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <span class="font-mono text-[11px] tracking-[0.2em] text-muted" aria-hidden="true">
      FIG. {num}
    </span>
    {
      featured && (
        <span class="rotate-2 border-2 border-stamp px-2 py-0.5 font-mono text-[10px] font-semibold tracking-[0.2em] text-stamp uppercase">
          Latest
        </span>
      )
    }
  </div>

  <h3 id={headingId} class="font-display text-[24px] font-semibold tracking-tight text-ink">
    {name}
  </h3>

  <p
    class="mt-3 max-w-[560px] text-[14.5px] leading-[1.8] font-light text-ink-1 [&_strong]:font-medium [&_strong]:text-ink"
    set:html={story}
  />

  <div class="mt-4 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="border border-line-strong px-2 py-0.5 font-mono text-[10.5px] tracking-wider text-ink-2">{tag}</span>
    ))}
  </div>

  {
    links.length > 0 && (
      <nav class="mt-5 flex gap-5 border-t border-line pt-4" aria-label={`${name} links`}>
        {links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="u-sweep font-mono text-[11.5px] tracking-[0.12em] text-blue-deep uppercase transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>
    )
  }
</article>
