---
import type { Project } from '../data/projects';

interface Props extends Project {
  delay?: number;
}

const { num, name, featured = false, story, tags, links = [], delay = 0 } = Astro.props;
---

<div
  class:list={[
    'group relative mb-0.5 translate-y-2.5 overflow-hidden border p-7 opacity-0 transition-colors duration-150 animate-fade-up',
    featured
      ? 'border-wash-line bg-wash hover:border-wash-line-hover hover:bg-wash-hover'
      : 'border-line bg-surface-2 hover:border-line-hover hover:bg-surface-hover',
  ]}
  style={`animation-delay: ${delay}s`}
>
  <span
    class="pointer-events-none absolute top-5 right-7 text-[52px] leading-none font-bold text-watermark transition-colors duration-200 group-hover:text-watermark-hover max-[600px]:hidden"
  >
    {num}
  </span>

  <div class="mb-3.5 flex flex-wrap items-baseline gap-1.5 max-[600px]:flex-col">
    <span class="text-[13px] font-semibold tracking-wide text-ink">{name}</span>
    {
      featured && (
        <span class="ml-3.5 inline-block border border-badge-line bg-badge px-2 py-0.5 text-[9px] tracking-[0.18em] text-amber uppercase opacity-90">
          latest
        </span>
      )
    }
  </div>

  <p
    class="max-w-[540px] font-sans text-[13.5px] leading-[1.8] font-light text-ink-4 italic [&_strong]:font-normal [&_strong]:text-ink-1 [&_strong]:not-italic"
    set:html={story}
  />

  <div class="mt-3.5 flex flex-wrap gap-2">
    {tags.map((tag) => <span class="border border-tag-line px-[7px] py-0.5 text-[10px] tracking-wider text-dimmer">{tag}</span>)}
  </div>

  {
    links.length > 0 && (
      <div class="mt-4 flex gap-4">
        {links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            class="border-b border-transparent pb-px text-[11px] tracking-wider text-amber uppercase opacity-70 transition-opacity duration-150 hover:border-amber hover:opacity-100"
          >
            {link.label}
          </a>
        ))}
      </div>
    )
  }
</div>
