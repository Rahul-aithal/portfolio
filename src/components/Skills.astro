---
import SectionHeader from './SectionHeader.astro';
import { skillGroups } from '../data/profile';
---

<section class="border-b-2 border-line-strong py-12" aria-labelledby="section-stack">
  <SectionHeader num="04" title="Stack" id="section-stack" />

  <div class="grid grid-cols-[repeat(auto-fill,minmax(220px,1fr))] gap-4 max-[600px]:grid-cols-2 max-[600px]:gap-3">
    {
      skillGroups.map((group, i) => {
        const headingId = `skill-${group.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
        return (
          <section
            class="border-2 border-line-strong bg-surface transition-all duration-150 hover:-translate-y-0.5 hover:border-blue-deep"
            aria-labelledby={headingId}
            data-reveal
            style={`transition-delay: ${i * 60}ms`}
          >
            <h3
              id={headingId}
              class="border-b-2 border-line-strong bg-ink px-4 py-2 font-mono text-[10px] font-semibold tracking-[0.2em] text-paper uppercase"
            >
              {group.label}
            </h3>
            <div
              class="px-4 py-3 text-[13.5px] leading-[1.9] font-light text-ink-1"
              set:html={group.lines.join('<br />')}
            />
          </section>
        );
      })
    }
  </div>
</section>
