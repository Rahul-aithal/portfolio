---

<footer class="mt-12 border-2 border-line-strong bg-surface font-mono text-[10.5px] tracking-[0.15em] uppercase" data-reveal>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 border-b border-line px-4 py-4">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
      <span class="font-semibold text-ink">Contact</span>
      <a
        href={`mailto:${profile.email}`}
        class="btn-press group inline-flex min-h-9 items-center gap-2.5 border-2 border-line-strong bg-surface px-4 py-2 text-[11px] font-semibold text-ink-2 transition-colors hover:border-blue hover:text-blue-deep"
      >
        Get in touch
        <span class="text-faint group-hover:text-blue" aria-hidden="true">↗</span>
      </a>
      <button
        type="button"
        data-agent-copy
        class="btn-press group inline-flex min-h-9 items-center gap-2.5 border-2 border-line-strong bg-surface px-4 py-2 text-[11px] font-semibold text-ink-2 transition-colors hover:border-blue hover:text-blue-deep"
        aria-label="Copy complete profile as Markdown for AI agents"
      >
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span data-agent-copy-label aria-live="polite">Copy profile</span>
      </button>
    </div>
    <nav class="flex items-center gap-2" aria-label="Contact links">
      {
        profile.links.map((link) => {
          const isStroke = strokeIcons.has(link.label);
          return (
            <a
              href={link.href}
              target={link.href.startsWith('mailto:') ? undefined : '_blank'}
              rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
              aria-label={`${link.label} — Rahul Aithal`}
              title={link.label}
              class="btn-press flex h-9 w-9 items-center justify-center border-2 border-line-strong bg-surface text-ink-2 transition-colors hover:border-blue hover:text-blue-deep"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill={isStroke ? 'none' : 'currentColor'}
                stroke={isStroke ? 'currentColor' : 'none'}
                stroke-width={isStroke ? '2.2' : undefined}
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={iconPaths[link.label]} />
              </svg>
            </a>
          );
        })
      }
    </nav>
  </div>
  <div class="grid grid-cols-2 max-[600px]:grid-cols-1">
    <div class="border-b border-line px-4 py-3 font-semibold text-ink max-[600px]:border-b">
      © {year} Rahul Aithal
    </div>
    <div class="border-b border-line px-4 py-3 text-muted max-[600px]:border-l-0 min-[601px]:border-l min-[601px]:text-right">
      {profile.education}
    </div>
    <div class="px-4 py-3 text-muted">Sheet 01 / 01</div>
    <div class="px-4 py-3 text-muted min-[601px]:border-l min-[601px]:border-line min-[601px]:text-right">
      Scale 1:1 — drawn & built by hand
    </div>
  </div>
</footer>

<script>
  function fallbackCopy(text: string) {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.left = '-9999px';
    document.body.append(textarea);
    textarea.select();

    const copied = document.execCommand('copy');
    textarea.remove();

    if (!copied) throw new Error('Copy command failed');
  }

  const copyButton = document.querySelector<HTMLButtonElement>('[data-agent-copy]');
  const copyLabel = copyButton?.querySelector<HTMLElement>('[data-agent-copy-label]');
  const defaultLabel = 'Copy profile';

  copyButton?.addEventListener('click', async () => {
    const brief = document.getElementById('agent-brief');
    if (!brief || !copyLabel) return;
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(brief.textContent ?? '');
      } else {
        fallbackCopy(brief.textContent ?? '');
      }
      copyLabel.textContent = 'Copied ✓';
    } catch {
      copyLabel.textContent = 'Failed';
    }
    window.setTimeout(() => {
      copyLabel.textContent = defaultLabel;
    }, 2200);
  });
</script>
