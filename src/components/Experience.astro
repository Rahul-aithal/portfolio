---
import SectionHeader from './SectionHeader.astro';
import { experiences } from '../data/profile';
---

<section class="border-b-2 border-line-strong py-12" aria-labelledby="section-experience">
  <SectionHeader num="02" title="Experience" id="section-experience" />

  <div class="flex flex-col gap-8">
    {
      experiences.map((job, index) => (
        <article
          class="border-2 border-line-strong bg-surface p-6 max-[600px]:p-5"
          aria-labelledby={`experience-heading-${index}`}
          data-reveal
        >
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 id={`experience-heading-${index}`} class="font-display text-[20px] font-semibold tracking-tight text-ink">
              {job.role}
            </h3>
            <span class="border border-line-strong px-2 py-0.5 font-mono text-[10px] tracking-[0.15em] text-muted uppercase">
              {job.period}
            </span>
          </div>
          <div class="mt-1.5 font-mono text-[11px] tracking-[0.12em] uppercase">
            <span class="font-semibold text-blue-deep">{job.company}</span>
            <span class="text-faint" aria-hidden="true"> / </span>
            <span class="text-muted">{job.location}</span>
          </div>
          <ul class="mt-5 flex flex-col gap-2.5 border-t border-line pt-5">
            {job.bullets.map((bullet) => (
              <li
                class="relative pl-5 text-[14.5px] leading-[1.75] font-light text-ink-1 before:absolute before:top-0 before:left-0 before:font-mono before:text-blue before:content-['+'] [&_strong]:font-medium [&_strong]:text-ink"
                set:html={bullet}
              />
            ))}
          </ul>
          <div class="mt-5 flex flex-wrap gap-2">
            {job.tags.map((tag) => (
              <span class="bg-blue-wash px-2 py-0.5 font-mono text-[10.5px] tracking-wider text-blue-deep">{tag}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>
